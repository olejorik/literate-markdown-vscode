{
    "name": "literate-markdown",
    "displayName": "Literate.jl Markdown highlighting",
    "description": "Highlights the Markdown of Literate.jl scripts: runs of '# ' lines and #= ... =# blocks, with the Quarto grammar; tasks for a live Quarto preview",
    "version": "0.2.0",
    "publisher": "olejorik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/olejorik/literate-markdown-vscode"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "julia",
        "literate",
        "quarto",
        "markdown"
    ],
    "extensionDependencies": [
        "julialang.language-julia"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onCommand:workbench.action.tasks.runTask",
        "onLanguage:julia"
    ],
    "contributes": {
        "grammars": [
            {
                "scopeName": "markdown.literate.julia",
                "path": "./syntaxes/literate-markdown.json",
                "injectTo": [
                    "source.julia"
                ]
            },
            {
                "scopeName": "markdown.literate.math.inline.julia",
                "path": "./syntaxes/literate-math-inline.json",
                "injectTo": [
                    "source.julia"
                ]
            },
            {
                "scopeName": "markdown.literate.math.block.julia",
                "path": "./syntaxes/literate-math-block.json",
                "injectTo": [
                    "source.julia"
                ]
            }
        ],
        "taskDefinitions": [
            {
                "type": "literate",
                "required": [
                    "action"
                ],
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "watch",
                            "blocks",
                            "install"
                        ],
                        "description": "watch: .jl → .qmd at every save; blocks: text lines into #= =# blocks; install: Literate.jl into the environment"
                    }
                }
            }
        ],
        "configuration": {
            "title": "Literate.jl Markdown",
            "properties": {
                "literateMarkdown.juliaExecutable": {
                    "type": "string",
                    "default": "",
                    "description": "Julia for the tasks of type literate; empty: julia.executablePath of the Julia extension, or julia on the PATH."
                },
                "literateMarkdown.juliaProject": {
                    "type": "string",
                    "default": "@literate",
                    "description": "Julia environment (--project) in which the tasks run; it must contain Literate.jl."
                }
            }
        },
        "configurationDefaults": {
            "[julia]": {
                "editor.unicodeHighlight.allowedCharacters": {
                    "–": true,
                    "—": true
                }
            }
        }
    },
    "scripts": {
        "test": "node test/tokenize.js test/sample.jl",
        "link": "node tools/link.js"
    },
    "devDependencies": {
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.0.0"
    }
}
